NODE_ENV=development
PORT=3000

# Frontend URL allowed to call the backend API
CORS_ORIGIN=http://localhost:5500

# MySQL / TiDB connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=library_app_user
DB_PASSWORD=change_me
DB_NAME=pdf_library
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_LIMIT=25
DB_QUEUE_LIMIT=5000

# Request/rate limits
REQUEST_BODY_LIMIT=50mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_BUCKETS=100000
PDF_LIST_RATE_LIMIT=1200
PDF_READ_RATE_LIMIT=300
VIDEO_RATE_LIMIT=300
AUTH_READ_RATE_LIMIT=600
AUTH_LOGIN_RATE_LIMIT=30
AI_ASK_RATE_LIMIT=30
ADMIN_RATE_LIMIT=2000
PUBLIC_BOOKS_CACHE_TTL_MS=30000
PREVIEW_CACHE_MAX_ENTRIES=50
# Keep false in production. Local development defaults to showing private rows so existing test data remains visible.
PUBLIC_INCLUDE_PRIVATE_BOOKS=false
# Keep false in production so old raw Google Drive ID routes cannot be used directly.
ALLOW_RAW_DRIVE_ROUTES=false

# Google sign-in verification
GOOGLE_CLIENT_ID=your_google_web_client_id

# Admin owner. This email can always manage the admin portal and grant admin access to others.
OWNER_ADMIN_EMAIL=padamkishore90@gmail.com

# Google Drive API access
DRIVE_CLIENT_ID=your_drive_client_id
DRIVE_CLIENT_SECRET=your_drive_client_secret
DRIVE_REDIRECT_URI=http://localhost
DRIVE_REFRESH_TOKEN=your_drive_refresh_token

# Firebase Admin credentials
# Use one of the two options below in production:
# 1) FIREBASE_SERVICE_ACCOUNT_JSON as the raw JSON string
# 2) FIREBASE_SERVICE_ACCOUNT_BASE64 as base64-encoded JSON
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Generate with: cd backend && npm run generate:session-secret
SESSION_TOKEN_SECRET=replace_with_a_long_random_secret
# Use "none" plus SESSION_COOKIE_SECURE=true if frontend and backend are on different domains in production.
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# Gemini / AI
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=1200

# AI upload safety limits
AI_MAX_FILES=6
AI_MAX_FILE_BYTES=10485760
AI_MAX_TEXT_CHARS_PER_FILE=6000
AI_ENABLE_IMAGE_OCR=true
AI_OCR_LANGUAGE=eng
